# ============================================================
# Pedidos360 - Plantilla .env para producción (EC2 / Docker)
# Copiar a .env y completar. Nunca commitear .env.
# cp .env.example .env
# En Linux: docker compose --env-file .env up -d
# O exportar: export $(cat .env | xargs) && docker compose up
# ============================================================

# ---------- Común ----------
JWT_ISSUER_URI=https://login.microsoftonline.com/1f3a849e-c198-4ff7-b67c-d17f15cbc152/v2.0

# ---------- Pedidos Service (prod: 8080 interno, host 8081) ----------
PEDIDOS_SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?ssl=true&sslmode=require&pgbouncer=true&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.myunbjgdvtkkvgaqemwz
SPRING_DATASOURCE_PASSWORD=CHANGEME

# URL del producto-service visto desde pedidos-service
# En docker compose prod: http://producto-service:8080
# En AWS API Gateway + EC2 separados: https://api.tudominio.com o http://<IP>:8080
PRODUCTO_SERVICE_URL=http://producto-service:8080

# ---------- Producto Service (prod: 8080 interno, host 8082) ----------
PRODUCTO_SERVER_PORT=8080
# Si comparten DB, reutiliza mismas vars; si DB separada, descomenta y usa vars dedicadas:
# PRODUCTO_SPRING_DATASOURCE_URL=jdbc:postgresql://...
# PRODUCTO_SPRING_DATASOURCE_USERNAME=...
# PRODUCTO_SPRING_DATASOURCE_PASSWORD=...
# Por defecto si no defines las de arriba, producto-service reutiliza SPRING_DATASOURCE_*

# ---------- Gateway (solo dev local, prod usa AWS API Gateway) ----------
GATEWAY_SERVER_PORT=8080
PEDIDOS_SERVICE_URL=http://pedidos-service:8080
PRODUCTOS_SERVICE_URL=http://producto-service:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://tu-vercel.vercel.app

# ---------- DB local dev (docker-compose.yml) ----------
POSTGRES_VERSION=postgres:15
PEDIDOS_DB_NAME=pedidos
PEDIDOS_DB_USER=user
PEDIDOS_DB_PASS=pass
PEDIDOS_DB_PORT=5431
PEDIDOS_DB_INTERNAL_PORT=5432

# ---------- Frontend (Vercel / local con env) ----------
# Para local rápido sin .env se usa environment.ts hardcodeado.
# Para Vercel / prod, setear estas en Vercel Dashboard o .env local + generate script:
NG_APP_MSAL_CLIENT_ID=9da5f704-8e4f-493b-af75-812436921593
NG_APP_MSAL_TENANT_ID=1f3a849e-c198-4ff7-b67c-d17f15cbc152
NG_APP_MSAL_REDIRECT_URI=http://localhost:4200
NG_APP_MSAL_API_SCOPE=api://374ba786-74ed-4b20-a6f5-b115c2e58625/Pedidos.Read
NG_APP_API_GATEWAY_URL=http://localhost:8080
NG_APP_LOG_LEVEL=DEBUG

# ---------- GHCR / Deploy ----------
# GHCR images: ghcr.io/roony11-1/pedidos-service:latest, ghcr.io/roony11-1/producto-service:latest
TAG=latest
# En EC2 public pull no requiere login, pero para private:
# GHCR_PAT=ghp_xxx
