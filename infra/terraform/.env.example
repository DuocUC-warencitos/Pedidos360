# ============================================================
# Pedidos360 - EC2 .env generado por Terraform (plantilla)
# Este .env se crea en cada EC2 vía user_data.sh a partir de outputs RDS + vars
# Copia local para probar docker-compose.prod.yml:
#   cp infra/terraform/.env.example .env && nano .env
# ============================================================

# ---------- Común ----------
JWT_ISSUER_URI=https://login.microsoftonline.com/1f3a849e-c198-4ff7-b67c-d17f15cbc152/v2.0

# ---------- DB (RDS endpoints generados por Terraform) ----------
# En EC2 se inyectan automáticamente desde outputs:
SPRING_DATASOURCE_URL=jdbc:postgresql://pedidos-db.XXXX.us-east-1.rds.amazonaws.com:5432/pedidos?ssl=true&sslmode=require
SPRING_DATASOURCE_USERNAME=pedidos_user
SPRING_DATASOURCE_PASSWORD=CHANGEME_SUPER_SEGURO_32CHARS

# ---------- Servicios ----------
PRODUCTO_SERVICE_URL=http://producto-ec2-private-ip:8080
PEDIDOS_SERVER_PORT=8080
PRODUCTO_SERVER_PORT=8080

# ---------- API Gateway (output) ----------
# NG_APP_API_GATEWAY_URL=https://xxxx.execute-api.us-east-1.amazonaws.com

# ---------- GHCR ----------
TAG=latest
