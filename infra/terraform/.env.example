# ============================================================
# Pedidos360 - EC2 .env generado por Terraform (plantilla)
# Este .env se crea en cada EC2 vía user_data.sh a partir de outputs RDS + vars
# Copia local para probar docker-compose.prod.yml:
#   cp infra/terraform/.env.example .env && nano .env
# ============================================================

# ---------- Común ----------
JWT_ISSUER_URI=https://login.microsoftonline.com/1f3a849e-c198-4ff7-b67c-d17f15cbc152/v2.0

# ---------- DB (2 RDS endpoints generados por Terraform) ----------
# En EC2 se inyectan automáticamente vía user_data.sh (cada EC2 su propia RDS):
# EC2 pedidos → pedidos-db, EC2 producto → producto-db
# Para docker-compose.prod.yml local (ambos servicios mismo host) define AMBAS:
SPRING_DATASOURCE_URL=jdbc:postgresql://pedidos-db.XXXX.us-east-1.rds.amazonaws.com:5432/pedidos?ssl=true&sslmode=require
SPRING_DATASOURCE_USERNAME=pedidos_user
SPRING_DATASOURCE_PASSWORD=CHANGEME_PEDIDOS

# Solo si usas docker-compose.prod.yml local con 2 DBs separadas, descomenta estas:
# PRODUCTO_SPRING_DATASOURCE_URL=jdbc:postgresql://producto-db.XXXX.us-east-1.rds.amazonaws.com:5432/productos?ssl=true&sslmode=require
# PRODUCTO_SPRING_DATASOURCE_USERNAME=producto_user
# PRODUCTO_SPRING_DATASOURCE_PASSWORD=CHANGEME_PRODUCTO
# Si no las defines, producto-service reutiliza SPRING_DATASOURCE_* (mono DB compartida para pruebas rápidas)

# ---------- Servicios ----------
PRODUCTO_SERVICE_URL=http://producto-ec2-private-ip:8080
PEDIDOS_SERVER_PORT=8080
PRODUCTO_SERVER_PORT=8080

# ---------- API Gateway (output) ----------
# NG_APP_API_GATEWAY_URL=https://xxxx.execute-api.us-east-1.amazonaws.com

# ---------- GHCR ----------
TAG=latest
