# ============================================================
# Pedidos360 - terraform.tfvars.example
# Copiar a terraform.tfvars y completar. Nunca commitear terraform.tfvars.
# cp terraform.tfvars.example terraform.tfvars
# ============================================================

aws_region   = "us-east-1"
environment  = "prod"
project      = "pedidos360"

# VPC default del lab (dejar vacío para auto-detectar)
vpc_id = ""

# EC2 — key pair del lab (Learner Lab usa "vockey")
key_name      = "vockey"
instance_type = "t3.micro"
# ami_id = "" # vacío = Amazon Linux 2023 último

# Acceso admin: SSH y Management UI de Rabbit solo desde esta IP (tu IP publica + /32)
admin_cidr = "TU_IP_PUBLICA/32"

# RDS — 2 instancias separadas
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20

db_name_pedidos        = "pedidos"
db_username_pedidos    = "pedidos_user"
db_name_producto       = "productos"
db_username_producto   = "producto_user"

# Passwords maestros — 32+ chars, sensibles
db_password          = "CHANGEME_SUPER_SEGURO_32CHARS_PEDIDOS"
db_password_producto = "" # vacío = reutiliza db_password

# JWT / Entra ID (reemplaza <TENANT_ID> y <API_CLIENT_ID>)
jwt_issuer_uri = "https://login.microsoftonline.com/<TENANT_ID>/v2.0"
jwt_audience   = "api://<API_CLIENT_ID>/Pedidos.Read"
cors_origins   = "http://localhost:4200,https://<tu-app>.vercel.app"

# GHCR — imagenes publicadas por el workflow (ghcr.io/duocuc-warencitos/*)
# Si los paquetes son privados, define GHCR_USERNAME/GHCR_TOKEN en infra\envs\comun.env.
ghcr_image_pedidos   = "ghcr.io/duocuc-warencitos/pedidos-service:latest"
ghcr_image_producto  = "ghcr.io/duocuc-warencitos/producto-service:latest"
tag                  = "latest"
