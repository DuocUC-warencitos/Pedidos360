#!/bin/bash
set -eux

# Expande la particion raiz al tamano del volumen EBS (idempotente)
if command -v growpart >/dev/null 2>&1; then
  growpart /dev/nvme0n1 1 >/dev/null 2>&1 || true
  xfs_growfs / >/dev/null 2>&1 || true
fi

# Actualiza e instala Docker + compose plugin (Amazon Linux 2023)
yum update -y
yum install -y docker git
systemctl enable --now docker
usermod -aG docker ec2-user

# Instala docker compose plugin si no existe
if ! docker compose version >/dev/null 2>&1; then
  mkdir -p /usr/local/lib/docker/cli-plugins
  curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose
  chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
fi

# Directorio app
mkdir -p /opt/pedidos360
chown ec2-user:ec2-user /opt/pedidos360
cd /opt/pedidos360

# Crea .env para docker-compose.yml desde variables Terraform
cat > .env <<'ENVEOF'
SPRING_DATASOURCE_URL=${spring_datasource_url}
SPRING_DATASOURCE_USERNAME=${db_username}
SPRING_DATASOURCE_PASSWORD=${db_password}
JWT_ISSUER_URI=${jwt_issuer_uri}
JWT_AUDIENCE=${jwt_audience}
SERVER_PORT=8080
PEDIDOS_SERVER_PORT=8080
PRODUCTO_SERVER_PORT=8080
PRODUCTO_SERVICE_URL=${producto_service_url}
CORS_ALLOWED_ORIGINS=${cors_origins}
TAG=${tag}
ENVEOF

# Copia docker-compose.yml via S3 si lo subes (descomentar y reemplaza BUCKET)
# aws s3 cp s3://BUCKET/docker-compose.yml ./docker-compose.yml

# Si el compose está embebido, créalo mínimo:
# Compose minimo de arranque. Los deploy-*.ps1 suben luego el compose definitivo.
# El nombre debe ser docker-compose.yml: `docker compose` no auto-detecta
# nombres como docker-compose.prod.yml.
cat > docker-compose.yml <<'COMPEOF'
services:
  app:
    image: ${ghcr_image}
    env_file: .env
    environment:
      SERVER_PORT: 8080
      SPRING_DATASOURCE_URL: $${SPRING_DATASOURCE_URL}
      SPRING_DATASOURCE_USERNAME: $${SPRING_DATASOURCE_USERNAME}
      SPRING_DATASOURCE_PASSWORD: $${SPRING_DATASOURCE_PASSWORD}
      JWT_ISSUER_URI: $${JWT_ISSUER_URI}
%{ if producto_service_url != "" ~}
      PRODUCTO_SERVICE_URL: $${PRODUCTO_SERVICE_URL}
%{ endif ~}
    ports:
      - "8080:8080"
    restart: unless-stopped
COMPEOF

# Los archivos recien creados quedan como ec2-user para que deploy-*.ps1 pueda sobreescribirlos
chown -R ec2-user:ec2-user /opt/pedidos360

# Pull y levantar (GHCR públicas no requieren login)
docker compose --env-file .env pull || true
docker compose --env-file .env up -d ||
  echo "Aviso: no se pudo levantar el stack inicial; usa infra/scripts/deploy-*.ps1"

# Logs
docker ps -a
