# Esquema del .env final de la EC2 producto-service (/opt/pedidos360/.env)
#
# AUTOMATICOS: deploy-producto-service.ps1 los completa desde terraform + comun.env.
# OVERRIDE: copia este archivo a .env en este mismo directorio y edita solo lo necesario.

SERVER_PORT=8080
CORS_ENABLED=false

GHCR_IMAGE_PRODUCTO=          # AUTO: comun.env o default ghcr.io/duocuc-warencitos/producto-service:latest

SPRING_DATASOURCE_URL=        # AUTO: RDS productos (jdbc)
SPRING_DATASOURCE_USERNAME=   # AUTO: RDS productos
SPRING_DATASOURCE_PASSWORD=   # AUTO: RDS productos

JWT_ISSUER_URI=               # AUTO: comun.env
