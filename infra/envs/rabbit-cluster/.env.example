# Esquema del .env final de la EC2 del cluster RabbitMQ (/opt/rabbit-cluster/.env)
#
# AUTOMATICOS: deploy-rabbit-cluster.ps1 los toma de infra/envs/comun.env
# (si RABBITMQ_PASSWORD o RABBITMQ_ERLANG_COOKIE estan vacios, los genera).
#
# OVERRIDE: copia este archivo a .env en este mismo directorio y edita solo
# lo necesario. OJO: usuario/password/cookie deben coincidir con lo que usen
# rabbit-admin y pedidos (que salen de comun.env).

RABBITMQ_USERNAME=          # AUTO: comun.env (default pedidos360)
RABBITMQ_PASSWORD=          # AUTO: comun.env (o generado)
RABBITMQ_ERLANG_COOKIE=     # AUTO: comun.env (o generado)
