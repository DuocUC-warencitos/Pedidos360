# Esquema del .env final de la EC2 analytics-service (/opt/analytics-service/.env)
#
# AUTOMATICOS: deploy-analytics-service.ps1 los completa desde terraform + comun.env.
# OVERRIDE: copia este archivo a .env en este mismo directorio y edita solo lo necesario.

SERVER_PORT=8080
# CORS: en AWS los servicios van true por defecto; no definas CORS_ENABLED aqui (solo es false en local).

GHCR_IMAGE_ANALYTICS=        # AUTO: comun.env o default ghcr.io/duocuc-warencitos/analytics-service:latest

JWT_ISSUER_URI=              # AUTO: comun.env
KAFKA_BOOTSTRAP_SERVERS=     # AUTO: IPs privadas de los 3 brokers Kafka (terraform output)
KAFKA_REPLICATION_FACTOR=3   # AUTO: topics de entrada con RF 3
KAFKA_STREAMS_STATE_DIR=/tmp/kafka-streams
JAVA_TOOL_OPTIONS=-Xmx768m   # t3.small (2 GB): limite de heap para Kafka Streams
