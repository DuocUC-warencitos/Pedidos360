# Overrides opcionales del cluster Kafka (3 brokers KRaft).
# deploy-kafka-cluster.ps1 genera el .env final por broker.
# Copia este archivo a .env solo si necesitas pisar valores.
#
# OJO: KAFKA_NODE_ID, BROKER_PRIVATE_IP, QUORUM_VOTERS,
# KAFKA_CLUSTER_ID y BOOTSTRAP_SERVERS los calcula el script.
# No los pongas aqui.

# Heap de cada broker (t3.small = 2 GB; no subir demasiado)
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g

# Puerto de Kafka UI en el broker elegido (solo admin_cidr)
UI_PORT=8080
