# Esquema del .env final de la EC2 pedidos-service (/opt/pedidos360/.env)
#
# AUTOMATICOS: deploy-pedidos-service.ps1 los completa desde terraform + comun.env.
# OVERRIDE: copia este archivo a .env en este mismo directorio y edita solo lo necesario.

SERVER_PORT=8080
CORS_ENABLED=false

GHCR_IMAGE_PEDIDOS=           # AUTO: comun.env o default ghcr.io/duocuc-warencitos/pedidos-service:latest

SPRING_DATASOURCE_URL=        # AUTO: RDS pedidos (jdbc)
SPRING_DATASOURCE_USERNAME=   # AUTO: RDS pedidos
SPRING_DATASOURCE_PASSWORD=   # AUTO: RDS pedidos

JWT_ISSUER_URI=               # AUTO: comun.env

PRODUCTO_SERVICE_URL=         # AUTO: http://<IP-privada-producto>:8080

RABBITMQ_HOST=                # AUTO: IP privada de la EC2 del cluster
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=            # AUTO: comun.env
RABBITMQ_PASSWORD=            # AUTO: comun.env
