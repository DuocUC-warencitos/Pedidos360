# Esquema del .env final de la EC2 rabbit-admin (/opt/rabbit-admin/.env)
#
# AUTOMATICOS: deploy-rabbit-admin.ps1 los completa desde terraform + comun.env.
# OVERRIDE: copia este archivo a .env en este mismo directorio y edita solo lo
# necesario (ej: apuntar SPRING_DATASOURCE_* a Supabase en vez del RDS admin).

SERVER_PORT=8080
CORS_ENABLED=false

GHCR_IMAGE_RABBIT_ADMIN=      # AUTO: comun.env o default ghcr.io/duocuc-warencitos/rabbitmq-admin-service:latest

SPRING_DATASOURCE_URL=        # AUTO: RDS admin (jdbc, base "admin" en la instancia RDS de pedidos)
SPRING_DATASOURCE_USERNAME=   # AUTO: RDS pedidos (mismo master user)
SPRING_DATASOURCE_PASSWORD=   # AUTO: RDS pedidos (mismo master user)

JWT_ISSUER_URI=               # AUTO: comun.env

RABBITMQ_HOST=                # AUTO: IP privada de la EC2 del cluster
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=            # AUTO: comun.env
RABBITMQ_PASSWORD=            # AUTO: comun.env
RABBITMQ_ADMIN_PORT=15672
RABBITMQ_MANAGEMENT_URL=      # AUTO: http://<IP-privada-cluster>:15672
