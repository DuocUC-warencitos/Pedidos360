# ============================================================
# Pedidos360 - secretos comunes de despliegue (local, NUNCA commitear)
# Copiar a comun.env o dejar que deploy-all.ps1 lo cree solo.
# Si RABBITMQ_PASSWORD / RABBITMQ_ERLANG_COOKIE quedan vacios,
# los scripts los generan automaticamente.
# ============================================================

# Key pair del Learner Lab (ruta local al .pem)
AWS_KEY_PATH=C:\Users\ricardo\Downloads\vockey.pem

# Credenciales RabbitMQ del cluster (sin espacios ni simbolos extranos)
RABBITMQ_USERNAME=pedidos360
RABBITMQ_PASSWORD=
RABBITMQ_ERLANG_COOKIE=

# JWT Entra ID (issuer)
JWT_ISSUER_URI=https://login.microsoftonline.com/1f3a849e-c198-4ff7-b67c-d17f15cbc152/v2.0

# Imagenes GHCR (dejar vacio = defaults :latest publicas)
GHCR_IMAGE_PEDIDOS=ghcr.io/duocuc-warencitos/pedidos-service:latest
GHCR_IMAGE_PRODUCTO=ghcr.io/duocuc-warencitos/producto-service:latest
GHCR_IMAGE_RABBIT_ADMIN=ghcr.io/duocuc-warencitos/rabbitmq-admin-service:latest
