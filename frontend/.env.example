# Frontend - plantilla env local (opcional)
# Para PCs públicos sin .env, ignora este archivo: npm start usa environment.ts hardcodeado.
# Para probar con envs: cp .env.example .env && npm run build / npm start
# En Vercel: copiar estas vars al Dashboard (Settings → Environment Variables) sin el prefijo NG_APP_ si tu script las mapea.

NG_APP_MSAL_CLIENT_ID=9da5f704-8e4f-493b-af75-812436921593
NG_APP_MSAL_TENANT_ID=1f3a849e-c198-4ff7-b67c-d17f15cbc152
NG_APP_MSAL_REDIRECT_URI=http://localhost:4200
NG_APP_MSAL_API_SCOPE=api://374ba786-74ed-4b20-a6f5-b115c2e58625/Pedidos.Read
NG_APP_API_GATEWAY_URL=http://localhost:8080
NG_APP_LOG_LEVEL=DEBUG
NG_APP_PRODUCTION=false

# Para prod Vercel + AWS API Gateway:
# NG_APP_MSAL_REDIRECT_URI=https://tu-app.vercel.app
# NG_APP_API_GATEWAY_URL=https://xxxxx.execute-api.us-east-1.amazonaws.com
# NG_APP_PRODUCTION=true
